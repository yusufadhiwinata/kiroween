# Edge Function secrets (set with: supabase secrets set --env-file supabase/.env)
# Copy this file to supabase/.env and fill in real values.
# Never commit supabase/.env and never put these values in the mobile app.
LLM_API_KEY=your-provider-key
# Any OpenAI-compatible endpoint works. The function appends /chat/completions.
#   OpenAI:     https://api.openai.com/v1
#   Anoman AI:  https://api.anoman.io/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Set to false if your provider/model does not support response_format=json_object
LLM_JSON_MODE=true
